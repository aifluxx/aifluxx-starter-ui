# Copy to .env.local (git-ignored). The proxy reads it; the browser never does.
# Leave AIFLUXX_API_KEY empty to run in mock mode.
AIFLUXX_API_KEY=
# Optional API root. Defaults to https://api.aifluxx.co.za.
# When this is empty, a dev URL in ~/.aifluxx/credentials is used
# (hostname starts with dev., for example https://dev.aifluxx.co.za).
AIFLUXX_API_URL=
# Optional MCP endpoint. Defaults to the resolved API root plus /mcp/
# (trailing slash included). Set this to point MCP somewhere else.
MCP_URL=
# Set to 1 to force mock mode even with a key.
AIFLUXX_MOCK=
# Local proxy port (bound to 127.0.0.1).
AIFLUXX_PROXY_PORT=8787
